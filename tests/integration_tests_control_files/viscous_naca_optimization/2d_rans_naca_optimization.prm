# Listing of Parameters
# ---------------------

set test_type = viscous_naca_optimization
set embedded_pde = true

# Number of dimensions
set dimension = 2

# The PDE we want to solve. Choices are
# <advection|diffusion|convection_diffusion>.
#set pde_type  = euler
set pde_type  = navier_stokes
#set pde_type = physics_model
#set model_type = reynolds_averaged_navier_stokes

#set conv_num_flux = roe
set conv_num_flux = lax_friedrichs
set diss_num_flux = bassi_rebay_2
#set diss_num_flux = symm_internal_penalty

set use_split_form = false

subsection euler
  set reference_length = 1.0
  set mach_infinity = 0.8
  set angle_of_attack = 0.0
end

subsection navier_stokes
  set reynolds_number_inf                 = 500000
  set prandtl_number                      = 0.71
  set temperature_inf                     = 293.15
end

subsection physics_model
  subsection reynolds_averaged_navier_stokes
    set turbulent_prandtl_number          = 0.72
  end
end

subsection linear solver
  set linear_solver_type = direct
  subsection gmres options
    set linear_residual_tolerance = 1e-8
    set max_iterations = 2000
    set restart_number = 100
    set ilut_fill = 1
    set ilut_drop = 1e-4
  end 
end

subsection ODE solver
  set output_solution_every_x_steps = 2
  # Maximum nonlinear solver iterations
  set nonlinear_max_iterations            = 150

  # Nonlinear solver residual tolerance
  set nonlinear_steady_residual_tolerance = 1e-7

  set initial_time_step = 1
  set time_step_factor_residual = 4.0
  set time_step_factor_residual_exp = 1.5

  # Print every print_iteration_modulo iterations of the nonlinear solver
  set print_iteration_modulo              = 1

  # Explicit or implicit solverChoices are <explicit|implicit>.
  set ode_solver_type  = implicit
end

subsection flow_solver
  set flow_case_type = airfoil_2D
  set steady_state = true
  set poly_degree = 1
  subsection grid
    subsection airfoil_2D
      set airfoil_length = 0.4
      set height = 4.0
      set length_b2 = 4.0
      set incline_factor = 0.08
      set bias_factor = 4.0
      set refinements = 0
      set n_subdivision_x_0 = 60
      set n_subdivision_x_1 = 70
      set n_subdivision_x_2 = 50
      set n_subdivision_y = 50
      set airfoil_sampling_factor = 100
    end
  end
end

subsection boundary_layer_extraction
  set number_of_sampling = 200
  set extraction_point_x = 0.36
  set extraction_point_y = 0.00546019
end

subsection amiet_model
  set acoustic_contribution_type = main_and_back
  set wall_pressure_spectral_model_type = Goody
  set omega_min = 100
  set omega_max = 10000
  set omega_interval = 1.0
  set observer_coord_ref_x = 0.0
  set observer_coord_ref_y = 0.0
  set observer_coord_ref_z = 2.0
  set ref_density = 1.204
  set chord_length = 0.4
  set span_length = 0.3
end
